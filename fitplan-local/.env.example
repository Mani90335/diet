# Copy to .env and supply the credentials for notification delivery.
FITPLAN_HOST=127.0.0.1
FITPLAN_PORT=8000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=you@gmail.com
