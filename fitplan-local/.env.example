# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=daily_fitness_reminder
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_API_VERSION=v23.0
